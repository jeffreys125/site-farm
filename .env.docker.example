# ===========================================================================
#  Docker deployment settings.
#  Copy to .env and edit -- `docker compose` reads this file automatically.
# ===========================================================================

# --- identity -------------------------------------------------------------
# The apex domain. Every subdomain under it becomes a site.
# DNS: point example.com and *.example.com at this server before going live.
DOMAIN=cnpkjp.com

# Host port mapped to the web container. Use 80 if BaoTa/Apache is not running.
HTTP_PORT=1111

# http until you put a TLS proxy in front; then switch to https and restart.
SITE_SCHEME=https

# Where the pipeline reaches WordPress to publish. Inside the compose network
# the site domains resolve to the web container, which has no TLS -- with
# SITE_SCHEME=https, publishing to https://<domain> fails with
# "SSL: WRONG_VERSION_NUMBER". Keeping this on http://web avoids that; the
# article links still come back on the public https origin.
# Leave empty only if WordPress lives somewhere else.
WP_INTERNAL_BASE=http://web

# Comma separated. "id:Display Title" or just "id".
SITES=hub,diy,woodworking,pet,camp,kitchen,auto,garden,homeoffice

BRAND=Northline

# --- WordPress admin ------------------------------------------------------
# Set these BEFORE the first `docker compose up`: wp core install runs once per
# site, so a site that already exists keeps the account it was created with.
# Leaving WP_ADMIN_USER as 'editor' is valid but is also the compose default --
# if the login keeps saying "no such user", that is where to look first.
WP_ADMIN_USER=editor
# Leave empty to have a random password generated on first boot (it is printed
# to `docker compose logs web` exactly once -- copy it somewhere safe).
WP_ADMIN_PASSWORD=
# Used for password resets. Leave empty for editor@<DOMAIN>.
WP_ADMIN_EMAIL=

# --- database -------------------------------------------------------------
DB_USER=wp
DB_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# --- AI provider ----------------------------------------------------------
# The client speaks OpenAI-compatible /chat/completions. Two ready-to-use
# blocks are below; enable exactly ONE of them.
#
# A) DeepSeek official (default)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_THINKING=
LLM_MAX_TOKENS=
#
# B) Self-hosted New API / one-api / any OpenAI-compatible gateway.
#    Reasoning models (e.g. dots3-note-prev) MUST have thinking off: otherwise
#    they spend the whole max_tokens budget on reasoning_content and return no
#    article body at all. LLM_PROVIDER=newapi turns it off by default.
#    To use B: comment out every line of A, then uncomment every line of B.
# LLM_PROVIDER=newapi
# LLM_API_KEY=ak-your-key
# LLM_BASE_URL=https://your-api.example.com/v1
# LLM_MODEL=dots3-note-prev
# LLM_THINKING=off
# LLM_MAX_TOKENS=8192
#
# Notes:
#   LLM_API_KEY wins over DEEPSEEK_API_KEY.
#   LLM_BASE_URL must include /v1 and must NOT end with a slash.
#   LLM_THINKING: on | off | auto (empty = provider default).

INDEXNOW_KEY=

# --- scheduling -----------------------------------------------------------
# false = idle container, you trigger runs by hand (recommended at the start)
# true  = run an automatic cycle
DAILY_ENABLED=true

# DAILY_AT=HH:MM pins the cycle to a wall-clock time (server local time), so
# a container restart does not shift it. Leave empty to use the old relative
# DAILY_INTERVAL sleep (which drifts by the length of each run).
DAILY_AT=04:00
# false = wait for the first DAILY_AT. true = run a cycle the moment the
# container starts (legacy behaviour: 27 posts on every rebuild).
RUN_ON_START=false
# Only used when DAILY_AT is empty.
DAILY_INTERVAL=86400
# Articles per site per cycle. Nine sites x 3 = 27 model calls per cycle.
DAILY_GEN_COUNT=3

# --- publishing -----------------------------------------------------------
# publish = live immediately | draft = review in WP admin | future = scheduled
PUBLISH_STATUS=publish
# The four below only matter when PUBLISH_STATUS=future. Posts are created as
# WordPress "future" posts, spread across these slots, and WP publishes them
# on its own at the planned time -- no container needs to be awake then.
PUBLISH_SCHEDULE_AT=06:00     # first slot of each day (site timezone)
PUBLISH_SPACING_MINUTES=180   # e.g. 06:00, 09:00, 12:00
PUBLISH_PER_DAY=3             # overflow rolls over to the next day
PUBLISH_TZ=Asia/Shanghai
