# ===========================================================================
#  Docker deployment settings.
#  Copy to .env and edit -- `docker compose` reads this file automatically.
# ===========================================================================

# --- identity -------------------------------------------------------------
# The apex domain. Every subdomain under it becomes a site.
# DNS: point example.com and *.example.com at this server before going live.
DOMAIN=example.com

# Host port mapped to the web container. Use 80 if BaoTa/Apache is not running.
HTTP_PORT=8080

# http until you put a TLS proxy in front; then switch to https and restart.
SITE_SCHEME=http

# Comma separated. "id:Display Title" or just "id".
SITES=hub,diy,woodworking,pet,camp,kitchen,auto,garden,homeoffice

BRAND=Northline

# --- WordPress admin ------------------------------------------------------
# Set these BEFORE the first `docker compose up`: wp core install runs once per
# site, so a site that already exists keeps the account it was created with.
# Leaving WP_ADMIN_USER as 'editor' is valid but is also the compose default --
# if the login keeps saying "no such user", that is where to look first.
WP_ADMIN_USER=editor
# Leave empty to have a random password generated on first boot (it is printed
# to `docker compose logs web` exactly once -- copy it somewhere safe).
WP_ADMIN_PASSWORD=
# Used for password resets. Leave empty for editor@<DOMAIN>.
WP_ADMIN_EMAIL=

# --- database -------------------------------------------------------------
DB_USER=wp
DB_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# --- content pipeline -----------------------------------------------------
DEEPSEEK_API_KEY=
INDEXNOW_KEY=

# false = idle container, you trigger runs by hand (recommended at the start)
# true  = run a full cycle every DAILY_INTERVAL seconds
DAILY_ENABLED=false
DAILY_GEN_COUNT=3
DAILY_INTERVAL=86400
PUBLISH_STATUS=draft
