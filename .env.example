# ===========================================================================
# Secrets. Never commit this file. Loaded automatically by scripts\daily.bat.
# ===========================================================================

# --- AI provider ----------------------------------------------------------
# A) DeepSeek official (default)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here
#
# B) Self-hosted New API / any OpenAI-compatible endpoint.
#    Comment out A and uncomment B. Reasoning models need LLM_THINKING=off.
# LLM_PROVIDER=newapi
# LLM_API_KEY=ak-your-key
# LLM_BASE_URL=https://your-api.example.com/v1
# LLM_MODEL=dots3-note-prev
# LLM_THINKING=off

# --- Indexing -------------------------------------------------------------
# 32-64 lowercase hex characters. Generate once:
#   python -c "import secrets;print(secrets.token_hex(32))"
# Then upload <KEY>.txt to the root of EVERY subdomain, containing the key itself.
INDEXNOW_KEY=

# --- WordPress application passwords (Users -> Profile -> Application Passwords)
WP_APP_PASSWORD_DIY=
WP_APP_PASSWORD_WOODWORKING=
WP_APP_PASSWORD_PET=
WP_APP_PASSWORD_CAMP=
WP_APP_PASSWORD_KITCHEN=
WP_APP_PASSWORD_AUTO=
WP_APP_PASSWORD_GARDEN=
WP_APP_PASSWORD_HOMEOFFICE=
